# -------------------------
# Training datasets
# -------------------------
data/raw/
data/intermediate/
data/processed/

# -------------------------
# Generated feature matrices
# -------------------------
data/features/

# -------------------------
# Generated reports
# -------------------------

# Ignore all generated report files by default
reports/**

# Keep the reports directory structure
!reports/
!reports/.gitkeep

# Keep final ML1 evaluation artifacts
!reports/commit_risk/
!reports/commit_risk/validation_model_comparison.csv
!reports/commit_risk/test_evaluation.csv

# Keep final ML2 Cppcheck evaluation artifacts
!reports/alert_prioritizer/
!reports/alert_prioritizer/cppcheck/
!reports/alert_prioritizer/cppcheck/validation_model_comparison.csv
!reports/alert_prioritizer/cppcheck/test_evaluation.csv

# Keep final ML2 Clang evaluation artifacts when generated
!reports/alert_prioritizer/clang/
!reports/alert_prioritizer/clang/validation_model_comparison.csv
!reports/alert_prioritizer/clang/test_evaluation.csv

# Keep ML3 evaluation artifacts
# Keep the ML3 report directory only
!reports/anomaly_detection/
!reports/anomaly_detection/.gitkeep

